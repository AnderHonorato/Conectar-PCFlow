                <ScrollViewer x:Name="PaginaConfiguracoes" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Configurações" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="Personalize o PCFlow do seu jeito." Foreground="{DynamicResource Texto2}"/><Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,7,0"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Aparência" FontSize="17" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button Content="Claro" Tag="claro" Click="Tema_Click"/><Button Content="Escuro" Tag="escuro" Click="Tema_Click"/><Button Content="Automático" Tag="automatico" Click="Tema_Click"/></StackPanel><TextBlock Text="Cor de destaque" Margin="0,12,0,4"/><StackPanel Orientation="Horizontal"><Button Content="●" Foreground="#F3B13F" Tag="dourado" Click="CorDestaque_Click"/><Button Content="●" Foreground="#2F80ED" Tag="azul" Click="CorDestaque_Click"/><Button Content="●" Foreground="#24D2C2" Tag="turquesa" Click="CorDestaque_Click"/><Button Content="●" Foreground="#8B5CF6" Tag="roxo" Click="CorDestaque_Click"/><Button Content="●" Foreground="#EC4899" Tag="rosa" Click="CorDestaque_Click"/></StackPanel></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,12,0,0"><StackPanel><TextBlock Text="Inicialização" FontSize="17" FontWeight="SemiBold"/><CheckBox x:Name="ConfigIniciarWindows" Content="Iniciar o PCFlow com o Windows"/><CheckBox x:Name="ConfigMinimizar" Content="Minimizar para a bandeja"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,12,0,0"><StackPanel><TextBlock Text="Descoberta na rede" FontSize="17" FontWeight="SemiBold"/><CheckBox x:Name="ConfigDescoberta" Content="Ativar descoberta na rede local (LAN)"/><TextBlock Text="Outros dispositivos PCFlow na mesma rede poderão encontrar este computador." Foreground="{DynamicResource Texto2}" TextWrapping="Wrap"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,12,0,0"><StackPanel><TextBlock Text="Atalhos" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Nova conexão    Ctrl + N" Foreground="{DynamicResource Texto2}" Margin="0,8,0,0"/><TextBlock Text="Mostrar PCFlow  Ctrl + Shift + P" Foreground="{DynamicResource Texto2}" Margin="0,5,0,0"/></StackPanel></Border></StackPanel><StackPanel Grid.Column="1" Margin="7,0,0,0"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Geral" FontSize="17" FontWeight="SemiBold"/><CheckBox x:Name="ConfigMostrarOffline" Content="Mostrar dispositivos offline"/><CheckBox x:Name="ConfigSons" Content="Reproduzir sons da interface"/><CheckBox x:Name="ConfigAnonimos" Content="Coletar dados de uso anônimos"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,12,0,0"><StackPanel><TextBlock Text="Notificações" FontSize="17" FontWeight="SemiBold"/><CheckBox x:Name="ConfigNotifConexoes" Content="Conexões e desconexões"/><CheckBox x:Name="ConfigNotifTransferencias" Content="Transferências concluídas"/><CheckBox x:Name="ConfigNotifNovos" Content="Novos dispositivos na rede"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,12,0,0"><StackPanel><TextBlock Text="Idioma" FontSize="17" FontWeight="SemiBold"/><ComboBox x:Name="ConfigIdioma"><ComboBoxItem Content="Português (Brasil)" Tag="pt-BR"/><ComboBoxItem Content="English" Tag="en"/><ComboBoxItem Content="Español" Tag="es"/></ComboBox></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,12,0,0"><StackPanel><TextBlock Text="Atualizações" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="✓ Você está na versão mais recente!" Foreground="{DynamicResource Sucesso}" Margin="0,7,0,0"/><TextBlock Text="PCFlow V1.3.0" Foreground="{DynamicResource Texto2}"/><Button Content="Verificar atualizações" Click="VerificarAtualizacoes_Click" HorizontalAlignment="Left"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,12,0,0"><StackPanel><TextBlock Text="Sobre o aplicativo" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="PCFlow V1.3.0" Foreground="{DynamicResource Destaque}" Margin="0,7,0,0"/><TextBlock Text="Conexões que aproximam você do que importa." Foreground="{DynamicResource Texto2}"/></StackPanel></Border></StackPanel></Grid><Button Content="Salvar configurações" Foreground="{DynamicResource Destaque}" BorderBrush="#6B552D" HorizontalAlignment="Right" Margin="0,14,0,0" Click="SalvarConfiguracoes_Click"/></StackPanel></ScrollViewer>
