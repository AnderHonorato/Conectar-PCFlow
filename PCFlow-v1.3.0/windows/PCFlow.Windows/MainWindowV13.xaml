<Window x:Class="PCFlow.Windows.MainWindowV13"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PCFlow V1.3" Width="1420" Height="900" MinWidth="1180" MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Fundo}" Foreground="{DynamicResource Texto}">
    <Window.Resources>
        <SolidColorBrush x:Key="Fundo" Color="#080B0F"/>
        <SolidColorBrush x:Key="Sidebar" Color="#0D1218"/>
        <SolidColorBrush x:Key="Painel" Color="#141B22"/>
        <SolidColorBrush x:Key="Painel2" Color="#1B242D"/>
        <SolidColorBrush x:Key="Borda" Color="#303A45"/>
        <SolidColorBrush x:Key="Destaque" Color="#F3B13F"/>
        <SolidColorBrush x:Key="Destaque2" Color="#24D2C2"/>
        <SolidColorBrush x:Key="Texto" Color="#F4F7FA"/>
        <SolidColorBrush x:Key="Texto2" Color="#9EABB8"/>
        <SolidColorBrush x:Key="Perigo" Color="#FF716A"/>
        <SolidColorBrush x:Key="Sucesso" Color="#24D2C2"/>

        <Style x:Key="BotaoBase" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Texto}"/><Setter Property="Background" Value="{DynamicResource Painel2}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Borda}"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,10"/><Setter Property="Margin" Value="4"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Raiz" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Raiz" Property="Opacity" Value="0.86"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Raiz" Property="Opacity" Value="0.68"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Raiz" Property="Opacity" Value="0.38"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource BotaoBase}"/>
        <Style x:Key="MenuButton" TargetType="Button" BasedOn="{StaticResource BotaoBase}"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Margin" Value="0,3"/><Setter Property="Padding" Value="15,12"/></Style>
        <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{DynamicResource Painel}"/><Setter Property="BorderBrush" Value="{DynamicResource Borda}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="18"/><Setter Property="Padding" Value="16"/></Style>
        <Style TargetType="TextBox"><Setter Property="Background" Value="#0D1319"/><Setter Property="Foreground" Value="{DynamicResource Texto}"/><Setter Property="BorderBrush" Value="{DynamicResource Borda}"/><Setter Property="Padding" Value="11,9"/></Style>
        <Style TargetType="PasswordBox"><Setter Property="Background" Value="#0D1319"/><Setter Property="Foreground" Value="{DynamicResource Texto}"/><Setter Property="BorderBrush" Value="{DynamicResource Borda}"/><Setter Property="Padding" Value="11,9"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,5"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource Texto}"/><Setter Property="Margin" Value="0,6"/></Style>
        <Style TargetType="RadioButton"><Setter Property="Foreground" Value="{DynamicResource Texto}"/><Setter Property="Margin" Value="0,6"/></Style>
        <Style TargetType="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{DynamicResource Texto}"/></Style>
        <Style TargetType="ListView"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{DynamicResource Borda}"/><Setter Property="Foreground" Value="{DynamicResource Texto}"/></Style>
        <Style TargetType="GridViewColumnHeader"><Setter Property="Background" Value="#111820"/><Setter Property="Foreground" Value="{DynamicResource Texto2}"/><Setter Property="Padding" Value="8"/></Style>
    </Window.Resources>

    <Grid Background="{DynamicResource Fundo}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{DynamicResource Sidebar}" BorderBrush="#232C35" BorderThickness="0,0,1,0">
            <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Margin="4,14,4,24"><StackPanel Orientation="Horizontal"><Border Width="44" Height="44" CornerRadius="13" Background="#202933" BorderBrush="{DynamicResource Borda}" BorderThickness="1"><TextBlock Text="↗" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource Destaque}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="10,2,0,0"><StackPanel Orientation="Horizontal"><TextBlock Text="PC" FontSize="22" FontWeight="Bold"/><TextBlock Text="Flow" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Destaque}"/><Border CornerRadius="6" BorderBrush="{DynamicResource Destaque}" BorderThickness="1" Margin="7,1,0,0"><TextBlock Text="V1.3" Foreground="{DynamicResource Destaque}" FontSize="9" Margin="5,2"/></Border></StackPanel><TextBlock Text="Conexões que aproximam" Foreground="{DynamicResource Texto2}" FontSize="9"/><TextBlock Text="você do que importa." Foreground="{DynamicResource Texto2}" FontSize="9"/></StackPanel></StackPanel></StackPanel>
                <StackPanel Grid.Row="1"><Button x:Name="MenuInicio" Style="{StaticResource MenuButton}" Tag="inicio" Content="⌂   Início" Click="Navegar_Click"/><Button x:Name="MenuDispositivos" Style="{StaticResource MenuButton}" Tag="dispositivos" Content="▣   Dispositivos" Click="Navegar_Click"/><Button x:Name="MenuSeguranca" Style="{StaticResource MenuButton}" Tag="seguranca" Content="♢   Segurança" Click="Navegar_Click"/><Button x:Name="MenuRemoto" Style="{StaticResource MenuButton}" Tag="remoto" Content="⇄   Acesso Remoto" Click="Navegar_Click"/><Button x:Name="MenuTransferencia" Style="{StaticResource MenuButton}" Tag="transferencia" Content="↔   Transferência" Click="Navegar_Click"/><Button x:Name="MenuConfiguracoes" Style="{StaticResource MenuButton}" Tag="configuracoes" Content="⚙   Configurações" Click="Navegar_Click"/></StackPanel>
                <StackPanel Grid.Row="2"><Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,8"><StackPanel Orientation="Horizontal"><Border Width="38" Height="38" Background="#2A3540" CornerRadius="19"><TextBlock Text="JS" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="9,1,0,0"><TextBlock Text="João Silva" FontWeight="SemiBold"/><TextBlock Text="Conta gratuita" Foreground="{DynamicResource Texto2}" FontSize="10"/></StackPanel></StackPanel></Border><Button Content="Minimizar para a bandeja" Click="Minimizar_Click"/><Button Content="Encerrar PCFlow" Foreground="{DynamicResource Perigo}" BorderBrush="#6A3538" Click="Encerrar_Click"/></StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#0A0E13" BorderBrush="#232C35" BorderThickness="0,0,0,1"><Grid Margin="26,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock x:Name="TituloTopo" Text="Início" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="SubtituloTopo" Text="Central de acesso remoto" Foreground="{DynamicResource Texto2}" FontSize="10"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Ellipse x:Name="StatusBolinha" Width="8" Height="8" Fill="{DynamicResource Sucesso}"/><TextBlock x:Name="TextoStatus" Text="Servidor ativo" Foreground="{DynamicResource Sucesso}" FontSize="11" Margin="7,0,12,0"/><Button x:Name="BotaoPausar" Content="Ⅱ  Pausar" Foreground="{DynamicResource Destaque}" BorderBrush="#6B552D" Click="Pausar_Click" Padding="12,7"/></StackPanel></Grid></Border>
            <Grid Grid.Row="1" Margin="24">
                <ScrollViewer x:Name="PaginaInicio" VerticalScrollBarVisibility="Auto"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <Border Style="{StaticResource Card}" BorderBrush="#5A4725" CornerRadius="24" Padding="22"><StackPanel><TextBlock Text="Seu endereço deste computador" FontSize="15"/><StackPanel Orientation="Horizontal" Margin="0,7,0,0"><TextBlock x:Name="TextoMaquinaId" Text="000 000 000" FontSize="38" FontFamily="Consolas" FontWeight="SemiBold"/><Button Content="⧉" Click="CopiarId_Click" Margin="12,0,0,0" Padding="12,6"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,6,0,0"><Ellipse Width="8" Height="8" Fill="{DynamicResource Sucesso}"/><TextBlock Text="Pronto para conexões" Foreground="{DynamicResource Sucesso}" Margin="7,0,0,0"/></StackPanel><TextBlock x:Name="TextoEndereco" Foreground="{DynamicResource Texto2}" FontSize="10" Margin="0,7,0,0"/></StackPanel></Border>
                    <Border Style="{StaticResource Card}" Margin="0,12,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="#F5F7FA" CornerRadius="16" Padding="8"><Image x:Name="ImagemQr" Width="145" Height="145"/></Border><StackPanel Grid.Column="1" Margin="18,4,0,0"><TextBlock Text="Conectar com QR Code" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Escaneie com o app do PCFlow no celular." Foreground="{DynamicResource Texto2}" Margin="0,5,0,0"/><TextBlock Text="Código temporário" Foreground="{DynamicResource Texto2}" FontSize="10" Margin="0,15,0,0"/><TextBlock x:Name="TextoPin" Text="000 000" Foreground="{DynamicResource Destaque}" FontSize="26" FontFamily="Consolas"/><StackPanel Orientation="Horizontal"><Button Content="Mostrar/copiar código" Click="CopiarPin_Click"/><Button Content="Gerar novo" Click="NovoCodigo_Click"/></StackPanel></StackPanel></Grid></Border>
                    <Border Style="{StaticResource Card}" Margin="0,12,0,0"><StackPanel><DockPanel><TextBlock Text="Dispositivos recentes" FontSize="18" FontWeight="SemiBold"/><Button Content="Ver todos" Tag="dispositivos" Click="Navegar_Click" DockPanel.Dock="Right" Padding="9,5"/></DockPanel><ListBox x:Name="ListaRecentesInicio" Margin="0,10,0,0" DisplayMemberPath="Resumo"/></StackPanel></Border>
                </StackPanel><StackPanel Grid.Column="1" Margin="12,0,0,0"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Este computador" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="TextoNomePc" Margin="0,12,0,0" FontSize="16"/><TextBlock x:Name="TextoSistema" Foreground="{DynamicResource Texto2}" Margin="0,5,0,0" TextWrapping="Wrap"/><TextBlock x:Name="TextoHardware" Foreground="{DynamicResource Texto2}" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,12,0,0"><StackPanel><TextBlock Text="Segurança" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Destaque2}"/><CheckBox x:Name="QuickPermitirConexoes" Content="Permitir conexões" IsChecked="True" Checked="QuickSeguranca_Changed" Unchecked="QuickSeguranca_Changed"/><CheckBox x:Name="QuickExigirConfirmacao" Content="Exigir confirmação" IsChecked="True" Checked="QuickSeguranca_Changed" Unchecked="QuickSeguranca_Changed"/><CheckBox x:Name="QuickSenhaAtiva" Content="Senha de acesso configurada" IsEnabled="False"/><Button Content="Abrir segurança" Tag="seguranca" Click="Navegar_Click"/></StackPanel></Border><Border Background="#19160F" BorderBrush="{DynamicResource Destaque}" BorderThickness="1" CornerRadius="20" Padding="17" Margin="0,12,0,0"><TextBlock Text="♛  PCFlow V1.3&#x0a;Uso pessoal gratuito&#x0a;&#x0a;Conexão, produtividade e tranquilidade." Foreground="{DynamicResource Destaque}" FontSize="14" TextWrapping="Wrap"/></Border></StackPanel></Grid></ScrollViewer>

                <Grid x:Name="PaginaDispositivos" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><DockPanel><StackPanel><TextBlock Text="Dispositivos" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="Gerencie todos os dispositivos autorizados." Foreground="{DynamicResource Texto2}"/></StackPanel><Button Content="+ Adicionar dispositivo" Click="AdicionarDispositivo_Click" DockPanel.Dock="Right"/></DockPanel><Grid Margin="0,18,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="210"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><TextBox x:Name="BuscaDispositivos" TextChanged="FiltroDispositivos_Changed"/><ComboBox x:Name="FiltroStatus" Grid.Column="1" Margin="8,0" SelectionChanged="FiltroDispositivos_Changed"><ComboBoxItem Content="Todos os status" IsSelected="True"/><ComboBoxItem Content="Confiáveis"/><ComboBoxItem Content="Bloqueados"/></ComboBox><ComboBox x:Name="FiltroFavoritos" Grid.Column="2" SelectionChanged="FiltroDispositivos_Changed"><ComboBoxItem Content="Todos" IsSelected="True"/><ComboBoxItem Content="Favoritos"/></ComboBox></Grid></StackPanel><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions><ListView x:Name="ListaDispositivos" SelectionChanged="ListaDispositivos_SelectionChanged" Margin="0,0,12,0"><ListView.View><GridView><GridViewColumn Header="Dispositivo" Width="180" DisplayMemberBinding="{Binding Nome}"/><GridViewColumn Header="ID" Width="170" DisplayMemberBinding="{Binding IdCurto}"/><GridViewColumn Header="Última conexão" Width="150" DisplayMemberBinding="{Binding Ultima}"/><GridViewColumn Header="Status" Width="110" DisplayMemberBinding="{Binding Status}"/><GridViewColumn Header="Favorito" Width="85" DisplayMemberBinding="{Binding FavoritoTexto}"/></GridView></ListView.View></ListView><Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Detalhes do dispositivo" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="DetalheNome" Text="Selecione um dispositivo" FontSize="17" Margin="0,15,0,0"/><TextBlock x:Name="DetalheId" Foreground="{DynamicResource Texto2}" Margin="0,6,0,0"/><TextBlock x:Name="DetalheUltima" Foreground="{DynamicResource Texto2}" Margin="0,6,0,14"/><Button Content="★ Alternar favorito" Click="FavoritarDispositivo_Click"/><Button Content="✎ Renomear" Click="RenomearDispositivo_Click"/><Button Content="Bloquear / liberar" Click="AlternarBloqueio_Click"/><Button Content="Revogar acesso" Foreground="{DynamicResource Perigo}" BorderBrush="#6A3538" Click="RevogarDispositivo_Click"/></StackPanel></Border></Grid></Grid>

                <ScrollViewer x:Name="PaginaSeguranca" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="♢" Foreground="{DynamicResource Destaque2}" FontSize="32"/><StackPanel Margin="10,0,0,0"><TextBlock Text="Segurança" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="Proteja seu computador e controle quem pode se conectar." Foreground="{DynamicResource Texto2}"/></StackPanel></StackPanel><Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}" Margin="0,0,6,0"><StackPanel><TextBlock Text="Permissões de conexão" FontSize="17" FontWeight="SemiBold"/><RadioButton x:Name="AcessoSempre" GroupName="Acesso" Content="Sempre solicitar" Checked="Seguranca_Changed"/><RadioButton x:Name="AcessoJanela" GroupName="Acesso" Content="Somente com a janela aberta" Checked="Seguranca_Changed"/><RadioButton x:Name="AcessoNunca" GroupName="Acesso" Content="Nunca solicitar" Checked="Seguranca_Changed"/></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource Card}" Margin="6,0"><StackPanel><TextBlock Text="Comportamento de confirmação" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Solicitações por ID exigem confirmação. QR/PIN válido funciona como confirmação local." Foreground="{DynamicResource Texto2}" TextWrapping="Wrap" Margin="0,8,0,0"/><CheckBox x:Name="CheckMoldura" Content="Mostrar moldura durante sessão" Checked="Seguranca_Changed" Unchecked="Seguranca_Changed"/></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource Card}" Margin="6,0,0,0"><StackPanel><TextBlock Text="Senha para acesso não assistido" FontSize="17" FontWeight="SemiBold"/><PasswordBox x:Name="CampoSenha" Margin="0,10,0,0"/><ProgressBar x:Name="ForcaSenha" Minimum="0" Maximum="4" Height="7" Margin="0,8,0,0"/><StackPanel Orientation="Horizontal"><Button Content="Alterar senha" Click="DefinirSenha_Click"/><Button Content="Remover" Click="RemoverSenha_Click"/></StackPanel></StackPanel></Border></Grid><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}" Margin="0,0,6,0"><StackPanel><DockPanel><TextBlock Text="Dispositivos de confiança" FontSize="17" FontWeight="SemiBold"/><Button Content="+ Adicionar" Click="AdicionarDispositivo_Click" DockPanel.Dock="Right" Padding="8,5"/></DockPanel><ListBox x:Name="ListaConfiaveis" DisplayMemberPath="Resumo" Margin="0,8,0,0"/></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource Card}" Margin="6,0,0,0"><StackPanel><TextBlock Text="Permissões da sessão" FontSize="17" FontWeight="SemiBold"/><CheckBox x:Name="CheckTela" Content="Exibir tela" Checked="Seguranca_Changed" Unchecked="Seguranca_Changed"/><CheckBox x:Name="CheckEntrada" Content="Permitir controle do mouse e teclado" Checked="Seguranca_Changed" Unchecked="Seguranca_Changed"/><CheckBox x:Name="CheckArquivos" Content="Permitir transferência de arquivos" Checked="Seguranca_Changed" Unchecked="Seguranca_Changed"/><CheckBox x:Name="CheckClipboard" Content="Permitir área de transferência" Checked="Seguranca_Changed" Unchecked="Seguranca_Changed"/><CheckBox x:Name="CheckEnergia" Content="Permitir comandos de energia" Checked="Seguranca_Changed" Unchecked="Seguranca_Changed"/></StackPanel></Border></Grid><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}" Margin="0,0,6,0"><StackPanel><TextBlock Text="Visibilidade na rede local (LAN)" FontSize="17" FontWeight="SemiBold"/><CheckBox x:Name="CheckDescoberta" Content="Ativar descoberta na rede local" Checked="Seguranca_Changed" Unchecked="Seguranca_Changed"/><TextBlock Text="Outros dispositivos PCFlow na mesma rede poderão encontrar este computador." Foreground="{DynamicResource Texto2}" TextWrapping="Wrap"/></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource Card}" Margin="6,0,0,0"><StackPanel><TextBlock Text="Atividade de segurança" FontSize="17" FontWeight="SemiBold"/><ListBox x:Name="ListaAtividade" Margin="0,8,0,0"/></StackPanel></Border></Grid><Button Content="Salvar segurança" Foreground="{DynamicResource Destaque}" BorderBrush="#6B552D" HorizontalAlignment="Right" Margin="0,14,0,0" Click="SalvarSeguranca_Click"/></StackPanel></ScrollViewer>

                <ScrollViewer x:Name="PaginaRemoto" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0"><TextBlock Text="Acesso Remoto" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="Controle seu computador de onde estiver, com segurança e desempenho." Foreground="{DynamicResource Texto2}"/><Border Style="{StaticResource Card}" Margin="0,16,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Seu código de conexão" Foreground="{DynamicResource Texto2}"/><TextBlock x:Name="TextoCodigoRemoto" FontSize="30" FontFamily="Consolas" Margin="0,5,0,0"/><TextBlock Text="● Pronto para conexões" Foreground="{DynamicResource Sucesso}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Senha adicional (opcional)" Foreground="{DynamicResource Texto2}"/><PasswordBox x:Name="CampoSenhaRemoto" Margin="0,6,0,0"/><Button Content="Aplicar senha" Click="AplicarSenhaRemoto_Click"/></StackPanel></Grid></Border><Border Style="{StaticResource Card}" Margin="0,12,0,0"><StackPanel><TextBlock Text="Configurações da sessão" FontSize="18" FontWeight="SemiBold"/><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock Text="Monitor"/><ComboBox x:Name="ComboMonitor" SelectionChanged="ConfiguracaoRemota_Changed"/><TextBlock Text="Qualidade da imagem" Margin="0,9,0,0"/><ComboBox x:Name="ComboQualidade" SelectionChanged="ConfiguracaoRemota_Changed"><ComboBoxItem Content="Automática" Tag="automatica"/><ComboBoxItem Content="Alta" Tag="alta"/><ComboBoxItem Content="Equilibrada" Tag="equilibrada"/><ComboBoxItem Content="Econômica" Tag="economica"/></ComboBox></StackPanel><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Taxa de quadros (FPS)"/><ComboBox x:Name="ComboFps" SelectionChanged="ConfiguracaoRemota_Changed"><ComboBoxItem Content="15"/><ComboBoxItem Content="30"/><ComboBoxItem Content="60"/></ComboBox><TextBlock Text="Interação de toque" Margin="0,9,0,0"/><ComboBox x:Name="ComboModoToque" SelectionChanged="ConfiguracaoRemota_Changed"><ComboBoxItem Content="Touch (Padrão)" Tag="touch"/><ComboBoxItem Content="Touchpad (Cursor)" Tag="touchpad"/></ComboBox></StackPanel></Grid><Separator Margin="0,12"/><TextBlock Text="Permissões da sessão" FontWeight="SemiBold"/><WrapPanel><CheckBox x:Name="RemotoEntrada" Content="Mouse e teclado"/><CheckBox x:Name="RemotoClipboard" Content="Clipboard"/><CheckBox x:Name="RemotoArquivos" Content="Arquivos"/><CheckBox x:Name="RemotoEnergia" Content="Energia"/></WrapPanel><StackPanel Orientation="Horizontal" Margin="0,9,0,0"><Button Content="▶ Iniciar sessão de teste" Foreground="#111" Background="{DynamicResource Destaque}" Click="IniciarTeste_Click"/><Button Content="↻ Gerar novo código" Click="NovoCodigo_Click"/></StackPanel></StackPanel></Border></StackPanel><StackPanel Grid.Column="1" Margin="10,0,0,0"><Border Style="{StaticResource Card}"><StackPanel><DockPanel><TextBlock Text="Prévia da sessão" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="● Ao vivo" Foreground="{DynamicResource Sucesso}" DockPanel.Dock="Right"/></DockPanel><Border Background="#06080B" BorderBrush="{DynamicResource Borda}" BorderThickness="1" CornerRadius="12" Margin="0,10,0,0"><Image x:Name="PreviewTela" Height="260" Stretch="Uniform"/></Border><TextBlock x:Name="PreviewInfo" Foreground="{DynamicResource Texto2}" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,12,0,0"><StackPanel><TextBlock Text="Dicas e recursos" FontSize="18" FontWeight="SemiBold"/><UniformGrid Columns="2" Margin="0,10,0,0"><Border Background="{DynamicResource Painel2}" CornerRadius="12" Margin="4" Padding="10"><TextBlock Text="☝ Toque&#x0a;Toque direto na tela." TextWrapping="Wrap"/></Border><Border Background="{DynamicResource Painel2}" CornerRadius="12" Margin="4" Padding="10"><TextBlock Text="▣ Touchpad&#x0a;Controle preciso do cursor." TextWrapping="Wrap"/></Border><Border Background="{DynamicResource Painel2}" CornerRadius="12" Margin="4" Padding="10"><TextBlock Text="⌨ Teclado&#x0a;Teclas e atalhos do sistema." TextWrapping="Wrap"/></Border><Border Background="{DynamicResource Painel2}" CornerRadius="12" Margin="4" Padding="10"><TextBlock Text="▤ Clipboard&#x0a;Copie e cole entre dispositivos." TextWrapping="Wrap"/></Border></UniformGrid></StackPanel></Border></StackPanel></Grid></ScrollViewer>

                <Grid x:Name="PaginaTransferencia" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Transferência de Arquivos" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="Transfira arquivos entre este computador e a área compartilhada do PCFlow." Foreground="{DynamicResource Texto2}"/></StackPanel><Grid Grid.Row="1" Margin="0,16,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="150"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Este computador" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="CaminhoLocal" Foreground="{DynamicResource Texto2}" FontSize="10" Margin="0,5,0,8" TextWrapping="Wrap"/><ListBox x:Name="ListaArquivosLocal" DisplayMemberPath="Resumo"/></StackPanel></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><Button Content="→  Enviar" Foreground="#111" Background="{DynamicResource Destaque}" Click="EnviarArquivo_Click"/><Button Content="←  Baixar" Foreground="#05201D" Background="{DynamicResource Destaque2}" Click="BaixarArquivo_Click"/><Button Content="Atualizar" Click="AtualizarArquivos_Click"/></StackPanel><Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Área compartilhada PCFlow" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="CaminhoCompartilhado" Foreground="{DynamicResource Texto2}" FontSize="10" Margin="0,5,0,8" TextWrapping="Wrap"/><ListBox x:Name="ListaArquivosCompartilhados" DisplayMemberPath="Resumo"/></StackPanel></Border></Grid><Border Grid.Row="2" Style="{StaticResource Card}" Padding="13"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Fila de transferências" FontWeight="SemiBold"/><TextBlock x:Name="TextoTransferencia" Text="Nenhuma transferência em andamento."