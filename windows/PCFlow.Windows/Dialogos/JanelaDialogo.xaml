<Window x:Class="PCFlow.Windows.Dialogos.JanelaDialogo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        Background="Transparent" ShowInTaskbar="False" SizeToContent="Manual"
        WindowStartupLocation="Manual" UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{DynamicResource FonteApp}" FontSize="13"
        Title="PCFlow">

    <!-- Véu: clique fora fecha quando a ação não é destrutiva. -->
    <Grid x:Name="Veu" Background="{DynamicResource Veu}" MouseLeftButtonDown="Veu_Click">
        <Border x:Name="Painel" Style="{StaticResource Cartao}" Width="460"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                MouseLeftButtonDown="Painel_Click" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TranslateTransform x:Name="Subida" Y="8"/>
            </Border.RenderTransform>

            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Border x:Name="MarcaFundo" Width="44" Height="44" CornerRadius="999"
                            Background="{DynamicResource AcaoSuave}" VerticalAlignment="Top">
                        <Path x:Name="MarcaIcone" Width="22" Height="22" Stretch="Uniform"
                              Data="{StaticResource IconeInfo}"
                              Stroke="{DynamicResource Acao}" StrokeThickness="1.7"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Border>
                    <StackPanel Margin="16,0,0,0" Width="356">
                        <TextBlock x:Name="Titulo" Style="{StaticResource TituloSecao}" Text="PCFlow"/>
                        <TextBlock x:Name="Mensagem" Style="{StaticResource Corpo}" Margin="0,8,0,0"
                                   Foreground="{DynamicResource TextoSecundario}"/>
                    </StackPanel>
                </StackPanel>

                <Border x:Name="CaixaDetalhe" Style="{StaticResource CartaoInterno}" Visibility="Collapsed"
                        Margin="0,0,0,16">
                    <ScrollViewer MaxHeight="180">
                        <TextBlock x:Name="Detalhe" Style="{StaticResource Legenda}"
                                   FontFamily="{DynamicResource FonteMono}"/>
                    </ScrollViewer>
                </Border>

                <StackPanel x:Name="AreaCampo" Visibility="Collapsed" Margin="0,0,0,16">
                    <TextBlock x:Name="RotuloCampo" Style="{StaticResource Secundario}" Margin="0,0,0,8"/>
                    <TextBox x:Name="Campo" KeyDown="Campo_KeyDown"/>
                    <PasswordBox x:Name="CampoSenha" Visibility="Collapsed" KeyDown="Campo_KeyDown"/>
                    <TextBlock x:Name="AvisoCampo" Style="{StaticResource Legenda}" Margin="0,8,0,0"
                               Foreground="{DynamicResource Erro}" Visibility="Collapsed"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BotaoCancelar" Content="Cancelar" Margin="0,0,12,0" MinWidth="120"
                            Click="Cancelar_Click"/>
                    <Button x:Name="BotaoConfirmar" Content="Entendi" Style="{StaticResource BotaoPrimario}"
                            MinWidth="140" Click="Confirmar_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
