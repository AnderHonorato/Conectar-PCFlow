<Window x:Class="PCFlow.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PCFlow"
        Width="1020" Height="680"
        MinWidth="600" MinHeight="420"
        ResizeMode="CanResize"
        SizeToContent="Manual"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        Background="#0E1218" Foreground="#F2F5F8"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <SolidColorBrush x:Key="Fundo" Color="#0E1218"/>
        <SolidColorBrush x:Key="Painel" Color="#151A21"/>
        <SolidColorBrush x:Key="PainelClaro" Color="#1B212A"/>
        <SolidColorBrush x:Key="Borda" Color="#2B323C"/>
        <SolidColorBrush x:Key="Destaque" Color="#F2AA2E"/>
        <SolidColorBrush x:Key="DestaqueFraco" Color="#6B5223"/>
        <SolidColorBrush x:Key="Sucesso" Color="#16D3C6"/>
        <SolidColorBrush x:Key="Alerta" Color="#FF8A80"/>
        <SolidColorBrush x:Key="Secundario" Color="#98A1AC"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EDF1F5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="Titulo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="Secao" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,18,0,8"/>
        </Style>
        <Style x:Key="Sub" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Secundario}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#EDF1F5"/>
            <Setter Property="Background" Value="#1B212A"/>
            <Setter Property="BorderBrush" Value="{StaticResource Borda}"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="raiz"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="raiz" Property="Background" Value="#242C36"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotaoPrimario" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="#0E1218"/>
            <Setter Property="Background" Value="{StaticResource Destaque}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Destaque}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,10"/>
        </Style>

        <Style x:Key="BotaoNav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="raiz" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="raiz" Property="Background" Value="#1B212A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#DDE3E9"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#11161C"/>
            <Setter Property="Foreground" Value="#EDF1F5"/>
            <Setter Property="BorderBrush" Value="{StaticResource Borda}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="CaretBrush" Value="#EDF1F5"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="Cartao" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Painel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Borda}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ColunaNav" Width="176"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Navegação lateral -->
        <Border Grid.Column="0" Background="#11161C" BorderBrush="{StaticResource Borda}" BorderThickness="0,0,1,0">
            <Grid Margin="12,16,12,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="4,4,0,22">
                    <Border Width="26" Height="20" BorderBrush="{StaticResource Destaque}"
                            BorderThickness="2" CornerRadius="4"/>
                    <TextBlock x:Name="RotuloLogo" Text="PCFlow" FontSize="17" FontWeight="SemiBold"
                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <Button x:Name="NavInicio" Style="{StaticResource BotaoNav}" Content="Início"
                            Tag="0" Click="Navegar_Click"/>
                    <Button x:Name="NavDispositivos" Style="{StaticResource BotaoNav}" Content="Dispositivos"
                            Tag="1" Click="Navegar_Click"/>
                    <Button x:Name="NavConexao" Style="{StaticResource BotaoNav}" Content="Conexão"
                            Tag="2" Click="Navegar_Click"/>
                    <Button x:Name="NavDiagnostico" Style="{StaticResource BotaoNav}" Content="Diagnóstico"
                            Tag="3" Click="Navegar_Click"/>
                    <Button x:Name="NavAjustes" Style="{StaticResource BotaoNav}" Content="Ajustes"
                            Tag="4" Click="Navegar_Click"/>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <TextBlock x:Name="RodapeVersao" Style="{StaticResource Sub}" Margin="4,0,0,10"/>
                    <Button Content="Minimizar para a bandeja" Click="Minimizar_Click" Margin="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Conteúdo -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Barra de status -->
            <Border Grid.Row="0" Background="#11161C" BorderBrush="{StaticResource Borda}"
                    BorderThickness="0,0,0,1" Padding="24,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="TituloPagina" Text="Início" FontSize="19" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <Ellipse x:Name="LuzStatus" Width="9" Height="9"
                                     Fill="{StaticResource Sucesso}" Margin="0,0,8,0"
                                     VerticalAlignment="Center"/>
                            <TextBlock x:Name="TextoStatus" Text="Iniciando…"
                                       Foreground="{StaticResource Sucesso}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BotaoPausar" Content="Pausar" Click="Pausar_Click" Margin="0,0,8,0"/>
                        <Button x:Name="BotaoLigar" Content="Parar servidor" Click="LigarDesligar_Click" Margin="0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Padding="24,20,24,24">
                <Grid>

                    <!-- ============ INÍCIO ============ -->
                    <StackPanel x:Name="PaginaInicio">
                        <Border Style="{StaticResource Cartao}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="220"/>
                                    <ColumnDefinition x:Name="ColunaQr" Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock x:Name="NomePc" Style="{StaticResource Titulo}" Text="—"/>
                                    <TextBlock x:Name="EnderecoPc" Style="{StaticResource Sub}" Margin="0,0,0,14"/>
                                    <TextBlock Text="Abra o PCFlow no Android: ele encontra este PC sozinho na rede local. No primeiro acesso, escaneie o QR ou digite o código."
                                               Style="{StaticResource Sub}" Margin="0,0,0,16"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Gerar novo código" Style="{StaticResource BotaoPrimario}"
                                                Click="NovoPin_Click"/>
                                        <Button Content="Copiar endereço" Click="CopiarEndereco_Click"/>
                                    </StackPanel>
                                </StackPanel>

                                <Border Grid.Column="1" Style="{StaticResource Cartao}" Margin="0"
                                        Background="#0B0F14" BorderBrush="{StaticResource DestaqueFraco}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="Escaneie com o aplicativo Android"
                                                   Style="{StaticResource Sub}"
                                                   HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                        <Border Background="White" Padding="8" CornerRadius="8"
                                                HorizontalAlignment="Center">
                                            <Image x:Name="ImagemQr" Width="168" Height="168"
                                                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                        </Border>
                                        <TextBlock Text="ou digite o PIN" Style="{StaticResource Sub}"
                                                   HorizontalAlignment="Center" Margin="0,12,0,4"/>
                                        <TextBlock x:Name="TextoPin" Text="— — —"
                                                   FontSize="30" FontFamily="Consolas"
                                                   Foreground="{StaticResource Destaque}"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="TextoExpira" Style="{StaticResource Sub}"
                                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <TextBlock Text="Dispositivos conhecidos" Style="{StaticResource Secao}"/>
                        <ItemsControl x:Name="ListaResumo">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#151A21" BorderBrush="#2B323C" BorderThickness="1"
                                            CornerRadius="12" Padding="14" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Nome}" FontSize="14" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Situacao}" FontSize="12"
                                                           Foreground="{Binding Cor}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Quando}"
                                                       Foreground="#98A1AC" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="AvisoSemDispositivos"
                                   Text="Nenhum celular pareado ainda. Instale o APK, abra o app e escaneie o código acima."
                                   Style="{StaticResource Sub}"/>
                    </StackPanel>

                    <!-- ============ DISPOSITIVOS ============ -->
                    <StackPanel x:Name="PaginaDispositivos" Visibility="Collapsed">
                        <TextBlock Text="Celulares autorizados a controlar este PC." Style="{StaticResource Sub}"
                                   Margin="0,0,0,14"/>
                        <ItemsControl x:Name="ListaDispositivos">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#151A21" BorderBrush="#2B323C" BorderThickness="1"
                                            CornerRadius="12" Padding="16" Margin="0,0,0,10">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Nome}" FontSize="15" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Situacao}" Foreground="{Binding Cor}"
                                                               FontSize="12" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Quando}"
                                                           Foreground="#98A1AC" VerticalAlignment="Top"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Detalhe}" Foreground="#7F8894"
                                                       FontSize="12" Margin="0,8,0,10"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Renomear" Tag="{Binding Id}" Click="Renomear_Click"/>
                                                <Button Content="{Binding TextoBloqueio}" Tag="{Binding Id}"
                                                        Click="Bloquear_Click"/>
                                                <Button Content="Remover" Tag="{Binding Id}" Click="Remover_Click"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="AvisoDispositivosVazio"
                                   Text="Nenhum dispositivo pareado. Vá em Início e escaneie o código com o celular."
                                   Style="{StaticResource Sub}"/>
                    </StackPanel>

                    <!-- ============ CONEXÃO ============ -->
                    <StackPanel x:Name="PaginaConexao" Visibility="Collapsed">
                        <Border Style="{StaticResource Cartao}">
                            <StackPanel>
                                <TextBlock Text="Rede" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <TextBlock x:Name="InfoRede" Style="{StaticResource Sub}"/>
                                <TextBlock x:Name="InfoPortas" Style="{StaticResource Sub}" Margin="0,6,0,0"/>
                                <TextBlock x:Name="InfoDescoberta" Style="{StaticResource Sub}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Cartao}">
                            <StackPanel>
                                <TextBlock Text="Firewall do Windows" FontSize="15" FontWeight="SemiBold"
                                           Margin="0,0,0,8"/>
                                <TextBlock x:Name="InfoFirewall" Style="{StaticResource Sub}" Margin="0,0,0,12"/>
                                <TextBlock Text="Se o celular encontra o PC mas a conexão falha, quase sempre é o firewall bloqueando a porta. O botão abaixo cria a regra apenas para a rede privada."
                                           Style="{StaticResource Sub}" Margin="0,0,0,12"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Liberar no firewall" Style="{StaticResource BotaoPrimario}"
                                            Click="Firewall_Click"/>
                                    <Button Content="Testar porta" Click="TestarPorta_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Cartao}">
                            <StackPanel>
                                <TextBlock Text="Servidor" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <CheckBox x:Name="ChkSomenteLan"
                                          Content="Aceitar conexões somente da rede local (recomendado)"
                                          Click="Config_Click"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
                                    <TextBlock Text="Porta de controle:" VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>
                                    <TextBox x:Name="CampoPorta" Width="90" MaxLength="5"/>
                                    <Button Content="Aplicar e reiniciar" Click="AplicarPorta_Click"
                                            Margin="10,0,0,0"/>
                                </StackPanel>
                                <Button Content="Reiniciar servidor" Click="Reiniciar_Click" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ============ DIAGNÓSTICO ============ -->
                    <StackPanel x:Name="PaginaDiagnostico" Visibility="Collapsed">
                        <Border Style="{StaticResource Cartao}">
                            <StackPanel>
                                <TextBlock x:Name="InfoDiagnostico" Style="{StaticResource Sub}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button Content="Exportar diagnóstico" Style="{StaticResource BotaoPrimario}"
                                            Click="Exportar_Click"/>
                                    <Button Content="Limpar tela" Click="LimparLog_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Registro de eventos" Style="{StaticResource Secao}"/>
                        <Border Background="#0B0F14" BorderBrush="{StaticResource Borda}" BorderThickness="1"
                                CornerRadius="12" Padding="12" MinHeight="240">
                            <ItemsControl x:Name="ListaLog">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12"
                                                   Foreground="#B9C2CC" Margin="0,0,0,2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>

                    <!-- ============ AJUSTES ============ -->
                    <StackPanel x:Name="PaginaAjustes" Visibility="Collapsed">
                        <Border Style="{StaticResource Cartao}">
                            <StackPanel>
                                <TextBlock Text="Geral" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <TextBlock Text="Ao fechar a janela:" Margin="0,0,0,6"/>
                                <ComboBox x:Name="ComboAoFechar" Width="260" HorizontalAlignment="Left"
                                          SelectionChanged="AoFechar_Changed">
                                    <ComboBoxItem Content="Minimizar para a bandeja"/>
                                    <ComboBoxItem Content="Encerrar o aplicativo"/>
                                    <ComboBoxItem Content="Perguntar sempre"/>
                                </ComboBox>
                                <CheckBox x:Name="ChkIniciarWindows" Content="Iniciar junto com o Windows"
                                          Click="Config_Click"/>
                                <CheckBox x:Name="ChkIniciarServidor" Content="Iniciar o servidor automaticamente"
                                          Click="Config_Click"/>
                                <CheckBox x:Name="ChkAbrirMinimizado" Content="Abrir minimizado na bandeja"
                                          Click="Config_Click"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Cartao}">
                            <StackPanel>
                                <TextBlock Text="Segurança" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <CheckBox x:Name="ChkPerguntarNovo"
                                          Content="Perguntar antes de permitir um dispositivo novo"
                                          Click="Config_Click"/>
                                <CheckBox x:Name="ChkConfirmarEnergia"
                                          Content="Pedir confirmação antes de desligar ou reiniciar"
                                          Click="Config_Click"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Cartao}">
                            <StackPanel>
                                <TextBlock Text="Recursos liberados ao celular" FontSize="15"
                                           FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <CheckBox x:Name="ChkEnergia" Content="Controle de energia (bloquear, suspender, desligar)"
                                          Click="Config_Click"/>
                                <CheckBox x:Name="ChkArquivos" Content="Explorador e transferência de arquivos"
                                          Click="Config_Click"/>
                                <CheckBox x:Name="ChkTela" Content="Ver a tela do PC no celular"
                                          Click="Config_Click"/>
                                <CheckBox x:Name="ChkClipboard" Content="Compartilhar a área de transferência"
                                          Click="Config_Click"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Cartao}">
                            <StackPanel>
                                <TextBlock Text="Sobre" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <TextBlock x:Name="InfoSobre" Style="{StaticResource Sub}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
