<Window x:Class="PCFlow.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PCFlow"
        Width="1100" Height="720" MinWidth="620" MinHeight="440"
        ResizeMode="CanResize" SizeToContent="Manual"
        WindowStartupLocation="Manual" UseLayoutRounding="True"
        Background="#0F1318" Foreground="#F5F7FA"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <SolidColorBrush x:Key="Painel" Color="#151A21"/>
        <SolidColorBrush x:Key="Painel2" Color="#1A2028"/>
        <SolidColorBrush x:Key="Borda" Color="#2E353F"/>
        <SolidColorBrush x:Key="Destaque" Color="#F2AA2E"/>
        <SolidColorBrush x:Key="Sucesso" Color="#13D4C4"/>
        <SolidColorBrush x:Key="Alerta" Color="#FF8A80"/>
        <SolidColorBrush x:Key="Secundario" Color="#98A1AC"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EDF1F5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Sub" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Secundario}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Secao" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F6F7F9"/>
            <Setter Property="Background" Value="#1A2028"/>
            <Setter Property="BorderBrush" Value="{StaticResource Borda}"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="raiz" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="11" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="raiz" Property="Background" Value="#242C36"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotaoPrimario" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="#0F1318"/>
            <Setter Property="Background" Value="{StaticResource Destaque}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Destaque}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,10"/>
        </Style>

        <Style x:Key="BotaoNav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="raiz" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="raiz" Property="Background" Value="#1A2028"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#C8CDD4"/>
            <Setter Property="Margin" Value="0,0,0,9"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#11161C"/>
            <Setter Property="Foreground" Value="#F5F7FA"/>
            <Setter Property="BorderBrush" Value="{StaticResource Borda}"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="CaretBrush" Value="#F5F7FA"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#11161C"/>
            <Setter Property="Foreground" Value="#F5F7FA"/>
            <Setter Property="BorderBrush" Value="{StaticResource Borda}"/>
            <Setter Property="Padding" Value="9,7"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="Cartao" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Painel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Borda}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ColunaNav" Width="192"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= NAVEGAÇÃO ================= -->
        <Border Grid.Column="0" Background="#12171D" BorderBrush="{StaticResource Borda}" BorderThickness="0,0,1,0">
            <Grid Margin="14,16,14,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="4,4,0,24">
                    <Border Width="28" Height="21" BorderBrush="{StaticResource Destaque}" BorderThickness="2" CornerRadius="4"/>
                    <TextBlock x:Name="RotuloLogo" Text="PCFlow" FontSize="18" FontWeight="SemiBold"
                               Margin="11,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <Button x:Name="MenuVisaoGeral" Style="{StaticResource BotaoNav}" Content="Visão geral" Tag="visao" Click="NavegarMenu_Click"/>
                    <Button x:Name="MenuConexao" Style="{StaticResource BotaoNav}" Content="Conexão" Tag="conexao" Click="NavegarMenu_Click"/>
                    <Button x:Name="MenuAcessoRemoto" Style="{StaticResource BotaoNav}" Content="Acesso remoto" Tag="remoto" Click="NavegarMenu_Click"/>
                    <Button x:Name="MenuDispositivos" Style="{StaticResource BotaoNav}" Content="Dispositivos" Tag="dispositivos" Click="NavegarMenu_Click"/>
                    <Button x:Name="MenuSeguranca" Style="{StaticResource BotaoNav}" Content="Segurança" Tag="seguranca" Click="NavegarMenu_Click"/>
                    <Button x:Name="MenuRecursos" Style="{StaticResource BotaoNav}" Content="Diagnóstico" Tag="recursos" Click="NavegarMenu_Click"/>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <TextBlock x:Name="RodapeVersao" Style="{StaticResource Sub}" Margin="4,0,0,10"/>
                    <Button Content="Minimizar para a bandeja" Click="Minimizar_Click" Margin="0,0,0,6"/>
                    <Button Content="Encerrar PCFlow" Click="Encerrar_Click" Foreground="#FF8A80" BorderBrush="#6A3535" Margin="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= CONTEÚDO ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#12171D" BorderBrush="{StaticResource Borda}"
                    BorderThickness="0,0,0,1" Padding="24,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="TituloPagina" Text="Visão geral" FontSize="19" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <Ellipse x:Name="LuzStatus" Width="9" Height="9" Fill="{StaticResource Sucesso}"
                                     Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TextoStatus" Text="Iniciando…" Foreground="{StaticResource Sucesso}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BotaoPausar" Content="Pausar" Click="Pausar_Click" Margin="0,0,8,0"
                                ToolTip="Pausar ou retomar conexões"/>
                        <Button Content="Atualizar" Click="Atualizar_Click" Margin="0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer x:Name="ScrollPrincipal" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Padding="24,20,24,24">
                <Grid>

                    <!-- ============ VISÃO GERAL ============ -->
                    <StackPanel x:Name="PaginaVisao">
                        <Border x:Name="SecaoVisaoGeral" Style="{StaticResource Cartao}"
                                BorderBrush="#3A3327">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="230"/>
                                    <ColumnDefinition x:Name="ColunaQr" Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                                    <TextBlock Text="Seu endereço PCFlow" Style="{StaticResource Sub}"/>
                                    <TextBlock x:Name="TextoMaquinaId" FontSize="38" FontFamily="Consolas"
                                               Foreground="{StaticResource Destaque}" Margin="0,4,0,4"/>
                                    <TextBlock x:Name="TextoEndereco" Style="{StaticResource Sub}"/>
                                    <TextBlock x:Name="TextoPin" FontSize="26" FontFamily="Consolas"
                                               Foreground="{StaticResource Destaque}" Margin="0,14,0,0"/>
                                    <TextBlock Text="Código de pareamento — digite no celular se preferir não escanear"
                                               Style="{StaticResource Sub}"/>
                                    <WrapPanel Margin="0,16,0,0">
                                        <Button Content="Gerar novo código" Style="{StaticResource BotaoPrimario}" Click="NovoCodigo_Click"/>
                                        <Button Content="Copiar ID" Click="CopiarId_Click"/>
                                        <Button Content="Copiar endereço" Click="CopiarEndereco_Click"/>
                                    </WrapPanel>
                                </StackPanel>

                                <Border Grid.Column="1" Background="#F5F7FA" CornerRadius="14" Padding="10"
                                        VerticalAlignment="Center">
                                    <Image x:Name="ImagemQr" Width="196" Height="196" Stretch="Uniform"/>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Cartao}">
                            <StackPanel>
                                <TextBlock Text="Como conectar o celular" Style="{StaticResource Secao}"/>
                                <TextBlock Style="{StaticResource Sub}" Margin="0,0,0,4"
                                           Text="1. Instale no celular o APK que veio junto com esta versão do PCFlow."/>
                                <TextBlock Style="{StaticResource Sub}" Margin="0,0,0,4"
                                           Text="2. Deixe os dois no mesmo Wi‑Fi. O último número do IP ser diferente é normal e esperado."/>
                                <TextBlock Style="{StaticResource Sub}" Margin="0,0,0,4"
                                           Text="3. Abra o app e toque em Escanear QR, ou escolha o PC na lista."/>
                                <TextBlock Style="{StaticResource Sub}"
                                           Text="4. Aceite a solicitação aqui no computador."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ============ CONEXÃO ============ -->
                    <StackPanel x:Name="PaginaConexao" Visibility="Collapsed">
                        <Border Style="{StaticResource Cartao}">
                            <StackPanel>
                                <TextBlock Text="Rede" Style="{StaticResource Secao}"/>
                                <TextBlock x:Name="InfoRede" Style="{StaticResource Sub}"/>
                                <TextBlock x:Name="InfoPortas" Style="{StaticResource Sub}" Margin="0,6,0,0"/>
                                <TextBlock x:Name="InfoTls" Style="{StaticResource Sub}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Cartao}">
                            <StackPanel>
                                <TextBlock Text="Firewall do Windows" Style="{StaticResource Secao}"/>
                                <TextBlock x:Name="InfoFirewall" Style="{StaticResource Sub}" Margin="0,0,0,12"/>
                                <TextBlock Style="{StaticResource Sub}" Margin="0,0,0,12"
                                           Text="Se o celular encontra o PC mas a conexão falha, quase sempre é o firewall bloqueando a porta. O botão abaixo cria a regra somente para a rede privada — nada é aberto para a internet. Pode ser usado quantas vezes quiser."/>
                                <WrapPanel>
                                    <Button Content="Liberar no firewall" Style="{StaticResource BotaoPrimario}" Click="Firewall_Click"/>
                                    <Button Content="Testar portas" Click="TestarPortas_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Cartao}">
                            <StackPanel>
                                <TextBlock Text="Servidor" Style="{StaticResource Secao}"/>
                                <CheckBox x:Name="CheckDescoberta" Content="Ser encontrado automaticamente na rede local" Click="Config_Click"/>
                                <CheckBox x:Name="CheckMinimizar" Content="Fechar a janela minimiza para a bandeja" Click="Config_Click"/>
                                <Button Content="Reiniciar servidor" Click="Reiniciar_Click" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ============ ACESSO REMOTO ============ -->
                    <StackPanel x:Name="PaginaRemoto" Visibility="Collapsed">
                        <Border x:Name="SecaoAcessoRemoto" Style="{StaticResource Cartao}">
                            <StackPanel>
                                <TextBlock Text="Controle remoto visual" Style="{StaticResource Secao}"/>
                                <TextBlock Style="{StaticResource Sub}"
                                           Text="O celular recebe a tela deste PC em tempo real e devolve toque, arraste, clique, rolagem e teclado — o dedo funciona como o ponteiro, igual a um acesso remoto de desktop. A transmissão usa TLS com pinagem da identidade desta máquina e só aceita endereços da rede local."/>
                                <WrapPanel Margin="0,14,0,0">
                                    <Button Content="Ir para segurança" Tag="seguranca" Click="NavegarMenu_Click"/>
                                    <Button Content="Atualizar QR/código" Click="NovoCodigo_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Cartao}">
                            <StackPanel>
                                <TextBlock Text="Permissões desta máquina" Style="{StaticResource Secao}"/>
                                <TextBlock Style="{StaticResource Sub}" Margin="0,0,0,12"
                                           Text="Valem para toda sessão nova. Desmarcar aqui bloqueia o recurso no servidor, não apenas na tela do celular."/>
                                <CheckBox x:Name="CheckTela" Content="Exibir a tela deste PC" Click="Config_Click"/>
                                <CheckBox x:Name="CheckEntrada" Content="Controlar teclado e mouse" Click="Config_Click"/>
                                <CheckBox x:Name="CheckClipboard" Content="Sincronizar área de transferência" Click="Config_Click"/>
                                <CheckBox x:Name="CheckEnergia" Content="Comandos de energia" Click="Config_Click"/>
                                <CheckBox x:Name="CheckArquivos" Content="Transferência de arquivos" Click="Config_Click"/>
                                <CheckBox x:Name="CheckMoldura" Content="Mostrar moldura na tela durante a sessão" Click="Config_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ============ DISPOSITIVOS ============ -->
                    <StackPanel x:Name="PaginaDispositivos" Visibility="Collapsed">
                        <DockPanel x:Name="TituloDispositivos" Margin="0,0,0,14">
                            <TextBlock DockPanel.Dock="Right" Text="Bloqueie ou revogue acessos salvos"
                                       Style="{StaticResource Sub}" VerticalAlignment="Center"/>
                            <TextBlock Text="Celulares autorizados" FontSize="16" FontWeight="SemiBold"/>
                        </DockPanel>
                        <ItemsControl x:Name="ListaDispositivos">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#151A21" BorderBrush="#2E353F" BorderThickness="1"
                                            CornerRadius="14" Padding="16" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Nome}" FontSize="15" FontWeight="SemiBold"/>
                                                <TextBlock Margin="0,4,0,0" FontSize="11">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Autorizado"/>
                                                            <Setter Property="Foreground" Value="#13D4C4"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Bloqueado}" Value="True">
                                                                    <Setter Property="Text" Value="Bloqueado"/>
                                                                    <Setter Property="Foreground" Value="#FF8A80"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding UltimaConexao, StringFormat='Última conexão: {0:dd/MM/yyyy HH:mm}'}"
                                                           Foreground="#7F8894" FontSize="11" Margin="0,6,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="Bloquear / liberar" Tag="{Binding Id}" Click="AlternarBloqueio_Click" FontSize="11"/>
                                                <Button Content="Revogar" Tag="{Binding Id}" Click="RevogarDispositivo_Click"
                                                        FontSize="11" Foreground="#FF8A80" BorderBrush="#6A3535" Margin="0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="AvisoSemDispositivos" Style="{StaticResource Sub}"
                                   Text="Nenhum celular autorizado ainda. Vá em Visão geral e escaneie o QR com o app."/>
                    </StackPanel>

                    <!-- ============ SEGURANÇA ============ -->
                    <StackPanel x:Name="PaginaSeguranca" Visibility="Collapsed">
                        <Border x:Name="PainelSeguranca" Style="{StaticResource Cartao}">
                            <StackPanel>
                                <TextBlock Text="Solicitações de conexão" Style="{StaticResource Secao}"/>
                                <TextBlock Style="{StaticResource Sub}" Margin="0,0,0,10"
                                           Text="Quem escaneia o QR ou digita o código já provou estar na frente deste PC e entra direto. As outras tentativas passam por esta regra."/>
                                <ComboBox x:Name="ComboAcesso" Width="300" HorizontalAlignment="Left"
                                          SelectionChanged="Config_Changed">
                                    <ComboBoxItem Content="Sempre solicitar" Tag="sempre"/>
                                    <ComboBoxItem Content="Somente com a janela aberta" Tag="janela"/>
                                    <ComboBoxItem Content="Nunca solicitar" Tag="nunca"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Cartao}">
                            <StackPanel>
                                <TextBlock Text="Acesso não supervisionado" Style="{StaticResource Secao}"/>
                                <TextBlock Style="{StaticResource Sub}" Margin="0,0,0,10"
                                           Text="Com uma senha definida, o celular entra sem que ninguém precise aceitar no PC. Use no seu próprio computador; mínimo de 8 caracteres."/>
                                <PasswordBox x:Name="CampoSenha" Width="300" HorizontalAlignment="Left" Margin="0,0,0,10"/>
                                <WrapPanel>
                                    <Button Content="Definir senha" Click="DefinirSenha_Click"/>
                                    <Button Content="Remover senha" Click="RemoverSenha_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ============ DIAGNÓSTICO ============ -->
                    <StackPanel x:Name="PaginaRecursos" Visibility="Collapsed">
                        <Border x:Name="SecaoRecursos" Style="{StaticResource Cartao}">
                            <StackPanel>
                                <TextBlock Text="Estado do sistema" Style="{StaticResource Secao}"/>
                                <TextBlock x:Name="TextoDiagnostico" Style="{StaticResource Sub}"
                                           Text="Clique em Atualizar para conferir as portas e o estado do servidor."/>
                                <WrapPanel Margin="0,14,0,0">
                                    <Button Content="Exportar diagnóstico" Style="{StaticResource BotaoPrimario}" Click="Exportar_Click"/>
                                    <Button Content="Atualizar" Click="Diagnostico_Click"/>
                                    <Button Content="Abrir Downloads" Click="AbrirDownloads_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Registro de eventos" Style="{StaticResource Secao}"/>
                        <Border Background="#0B0F14" BorderBrush="{StaticResource Borda}" BorderThickness="1"
                                CornerRadius="14" Padding="12" MinHeight="220">
                            <ItemsControl x:Name="ListaLog">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12"
                                                   Foreground="#B9C2CC" Margin="0,0,0,2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>

                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
